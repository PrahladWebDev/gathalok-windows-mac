{
  "name": "gathalok-desktop",
  "productName": "GathaLok",
  "version": "1.0.1",
  "private": true,
  "description": "GathaLok \u2014 living archive of world folklore (desktop app)",
  "author": "GathaLok",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win",
    "build:win:dir": "vite build && electron-builder --win --dir",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.gathalok.desktop",
    "productName": "GathaLok",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "identityName": "PrahladSinghLabs.GathaLok",
      "publisher": "CN=5012F72D-7480-41B7-AEA3-A21BB6FD1626",
      "publisherDisplayName": "Prahlad Singh Labs",
      "applicationId": "GathaLok"
    }
  }
}